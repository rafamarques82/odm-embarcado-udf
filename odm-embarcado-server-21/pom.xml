<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.itau.odm</groupId>
    <artifactId>odm-embarcado-server-21</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ODM Embarcado - Servidor Standalone (Java 21)</name>
    <description>
        Processo standalone Java 21, isolado da JVM do Spark/Glue (que roda em Java 8/17).
        Hospeda o XU do ODM 9.5 (via FacadeSessionFactory, reaproveitada de embarcado-95.jar)
        e atende requisições de execução de regras por socket TCP local, para permitir que
        rulesets/XOM que exigem classfile Java 21 continuem rodando sem "marretar" o bytecode
        deles para um target inferior (o que tiraria o artefato do suporte oficial).
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <gson.version>2.10.1</gson.version>
        <odm.version>9.5.0.1</odm.version>
        <spark.version>3.3.0</spark.version>
        <aws.sdk.version>1.12.529</aws.sdk.version>
        <udf95.dir>${project.basedir}/../odm-embarcado-udf-95</udf95.dir>
        <!-- Pasta onde ficam os jars ODM 9.5 ORIGINAIS (sem alteração) no repositório -->
        <odm95.dir>${project.basedir}/../lib/95</odm95.dir>
    </properties>

    <dependencies>
        <!-- Spark Core (provided para compatibilidade com classes Spark) -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_2.12</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_2.12</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- AWS SDK S3 -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-java-sdk-s3</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>

        <!-- Kafka -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.3.1</version>
        </dependency>

        <!-- IBM ODM 9.5 — mesmos jars usados pela UDF -->
        <dependency>
            <groupId>com.ibm.rules</groupId>
            <artifactId>jrules-engine</artifactId>
            <version>${odm.version}</version>
            <scope>system</scope>
            <systemPath>${odm95.dir}/jrules-engine.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.ibm.rules</groupId>
            <artifactId>jrules-res-execution</artifactId>
            <version>${odm.version}</version>
            <scope>system</scope>
            <systemPath>${odm95.dir}/jrules-res-9.5.0.1-execution.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.ibm.rules</groupId>
            <artifactId>jrules-res-session</artifactId>
            <version>${odm.version}</version>
            <scope>system</scope>
            <systemPath>${odm95.dir}/jrules-res-9.5.0.1-session-java.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.ibm.license</groupId>
            <artifactId>license-metric-logger</artifactId>
            <version>2.1.2</version>
            <scope>system</scope>
            <systemPath>${udf95.dir}/lib/license_metric_logger_2.1.2.202009181115.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>jakarta.resource</groupId>
            <artifactId>jakarta.resource-api</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Ruleset + XOM opcionais (se colocados em lib/) -->
        <!-- Caso existam localmente em lib/, são incluídos no classpath -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven AntRun Plugin - Descompacta EXCLUSIVAMENTE os JARs proprietários IBM ORIGINAIS (Java 21) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>unpack-odm-jars</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Descompactando EXCLUSIVAMENTE os JARs ODM 9.5 100% ORIGINAIS da IBM (Java 21)..."/>
                                <unzip src="${odm95.dir}/jrules-engine.jar"
                                       dest="${project.build.directory}/classes"
                                       overwrite="true"/>
                                <unzip src="${odm95.dir}/jrules-res-9.5.0.1-execution.jar"
                                       dest="${project.build.directory}/classes"
                                       overwrite="true"/>
                                <unzip src="${odm95.dir}/jrules-res-9.5.0.1-session-java.jar"
                                       dest="${project.build.directory}/classes"
                                       overwrite="true"/>
                                <unzip src="${odm95.dir}/guicustomization-1.0.jar"
                                       dest="${project.build.directory}/classes"
                                       overwrite="true"/>
                                <unzip src="${project.basedir}/../odm-embarcado-udf-95/lib/license_metric_logger_2.1.2.202009181115.jar"
                                       dest="${project.build.directory}/classes"
                                       overwrite="true"/>
                                <echo message="JARs 100% originais da IBM embutidos com sucesso!"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Fat JAR: o processo standalone precisa subir sozinho, sem depender
                 de um classpath externo montado na mão -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.com.itau.odm.embarcado.server.OdmServer</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
